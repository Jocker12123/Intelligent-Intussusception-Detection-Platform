# ============================================================
# 后端环境变量模板（复制为 .env 并把值改成实际配置）
# 生产部署前务必设置 JWT_SECRET_KEY 和 ALLOWED_ORIGINS。
# ============================================================

# --- 安全 ---
# JWT 签名密钥：生产必须用长度>=32 的随机字符串
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# 允许跨域的前端源（多个用英文逗号分隔）。禁止使用 *（配合凭证会失效）
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# token 有效期（分钟），默认 480（8 小时）
JWT_EXPIRE_MINUTES=480

# --- 数据库 ---
# SQLite（默认）
DATABASE_URL=sqlite:///./app.db
# 如切换到 PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- 文件存储 ---
# 影像存储目录（默认项目根目录下的 uploads/）
UPLOAD_DIR=./uploads

# --- 业务 ---
# 医院所在时区（用于"今日"统计边界）
LOCAL_TIMEZONE=Asia/Shanghai
